{
  "name": "fde-backend-apis",
  "version": "1.0.0",
  "private": true,
  "description": "Products API with Serverless Framework v3, TypeScript, DynamoDB, S3 and SSM",
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:products": "rm -rf services/products/dist && tsc -p services/products/tsconfig.json",
    "deploy:resources": "cd resources && serverless deploy",
    "deploy:products": "cd services/products && serverless deploy",
    "offline:products": "cd services/products && serverless offline",
    "remove:products": "cd services/products && serverless remove",
    "remove:resources": "cd resources && serverless remove"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1157.0",
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/lib-dynamodb": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "serverless-offline": "^13.10.2",
    "serverless-plugin-scripts": "^1.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
